# =============================================================================
#  Exp3_CPLD_Slave.sdc —— 时序约束
#
#  只约束一件事：clk 是 50 MHz 的时钟（周期 20 ns）。
#  不写这个文件时 Quartus 会按默认 1 GHz 去算时序，然后报一大堆“负裕量”，
#  那是假警报；写上之后 TimeQuest 才有正确的比较基准。
#
#  SCK / CS 是异步输入，在本设计里只被 clk 采样（两级同步 + 边沿检测），
#  不需要额外约束，靠同步器本身保证可靠性。
# =============================================================================
create_clock -name clk -period 20.000 [get_ports {clk}]
derive_clock_uncertainty
